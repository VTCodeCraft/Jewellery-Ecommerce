{% doc %}
  Renders breadcrumbs for collection, product, page, etc.
  Shows Home / Shop / [Collection] / [Product] as per screenshot
{% enddoc %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list list-unstyled" style="display:flex; gap:6px; font-size:13px; color:#6B5A4A;">
    <li class="breadcrumbs__item"><a href="{{ routes.root_url }}" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">Home</a></li>
    <li class="breadcrumbs__separator" aria-hidden="true">/</li>
    {% if collection and collection.handle != 'all' and template.name == 'collection' %}
      {% capture display_title %}{% render 'collection-display-title', collection: collection %}{% endcapture %}
      <li class="breadcrumbs__item"><a href="/collections/all" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">Shop</a></li>
      <li class="breadcrumbs__separator" aria-hidden="true">/</li>
      <li class="breadcrumbs__item" aria-current="page">{{ display_title }}</li>
    {% elsif collection and template.name == 'product' %}
      {% assign prod_collection = product.collections | first %}
      {% capture prod_display_title %}{% render 'collection-display-title', collection: prod_collection %}{% endcapture %}
      <li class="breadcrumbs__item"><a href="/collections/all" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">Shop</a></li>
      <li class="breadcrumbs__separator" aria-hidden="true">/</li>
      {% if prod_collection %}
        <li class="breadcrumbs__item"><a href="{{ prod_collection.url }}" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">{{ prod_display_title }}</a></li>
        <li class="breadcrumbs__separator" aria-hidden="true">/</li>
      {% endif %}
      <li class="breadcrumbs__item" aria-current="page">{{ product.title | truncate: 30 }}</li>
    {% elsif template.name == 'collection' and collection.handle == 'all' %}
      <li class="breadcrumbs__item"><a href="/collections/all" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">Shop</a></li>
      <li class="breadcrumbs__separator" aria-hidden="true">/</li>
      <li class="breadcrumbs__item" aria-current="page">{{ collection.title | default: 'All' }}</li>
    {% elsif template.name == 'page' %}
      <li class="breadcrumbs__item"><a href="/collections/all" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">Shop</a></li>
      <li class="breadcrumbs__separator" aria-hidden="true">/</li>
      <li class="breadcrumbs__item" aria-current="page">{{ page.title }}</li>
    {% else %}
      <li class="breadcrumbs__item"><a href="/collections/all" class="breadcrumbs__link" style="color:inherit; text-decoration:none;">Shop</a></li>
      <li class="breadcrumbs__separator" aria-hidden="true">/</li>
      <li class="breadcrumbs__item" aria-current="page">{{ page_title | default: collection.title | default: product.title }}</li>
    {% endif %}
  </ol>
</nav>
