{% doc %}
  Renders short product description without Jewellery care section
  @param {product} product - The product object
{% enddoc %}
{% liquid
  assign desc = product.description
  if desc contains 'Jewellery care:'
    assign parts = desc | split: 'Jewellery care:'
    echo parts.first
  elsif desc contains 'Jewellery Care:'
    assign parts = desc | split: 'Jewellery Care:'
    echo parts.first
  else
    echo desc
  endif
  # For choker anomaly, show set-consists under visible description if present in care metafield
  assign care = product.metafields.custom.care_instructions
  if care contains 'THIS JEWELLERY SET CONSIST'
    assign set_part = care | split: 'WIPE YOUR JEWELLERY' | first
    echo '<p>' | append: set_part | append: '</p>'
  endif
%}