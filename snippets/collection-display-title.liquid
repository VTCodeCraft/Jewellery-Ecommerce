{%- doc -%}
  Returns a clean display title for a collection handle, replacing "/" with "&"
  in category names. Falls back to collection.title for unmapped handles.

  @param {object} collection - The collection object
  @return {string} The display title

  @example
  {% render 'collection-display-title', collection: collection %}
{%- enddoc -%}

{% liquid
  case collection.handle
    when 'necklaces-pendants'
      assign display_title = 'Necklaces & Pendants'
    when 'jewellery-sets'
      assign display_title = 'Jewellery Sets'
    when 'earrings'
      assign display_title = 'Earrings'
    when 'rings'
      assign display_title = 'Rings'
    when 'wedding'
      assign display_title = 'Wedding'
    when 'festival'
      assign display_title = 'Festival'
    when 'dailywear'
      assign display_title = 'Dailywear'
    when 'partywear'
      assign display_title = 'Partywear'
    when 'featured-products'
      assign display_title = 'Featured Products'
    when 'best-sellers'
      assign display_title = 'Best Sellers'
    when 'new-arrivals'
      assign display_title = 'New Arrivals'
    else
      assign display_title = collection.title
  endcase
%}{{ display_title }}
