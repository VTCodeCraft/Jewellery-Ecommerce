{%- doc -%}
  Collection banner image, resolved per collection handle from theme assets.

  Rendered only inside templates/collection.json, so it can never leak into
  footer or other sections. Add `assets/banner-<handle>.png` to support a
  new collection; handles without a matching asset render nothing.

  Desktop only (>= 990px): the image cell is hidden below that, leaving the
  heading text full-width with no empty space left behind.
{%- enddoc -%}

{% liquid
  assign banner_file = ''
  case collection.handle
    when 'all'
      assign banner_file = 'banner-all.png'
    when 'best-sellers'
      assign banner_file = 'banner-best-sellers.png'
    when 'featured-products'
      assign banner_file = 'banner-featured.png'
    when 'wedding'
      assign banner_file = 'banner-wedding.png'
    when 'traditional-festival'
      assign banner_file = 'banner-traditional.png'
    when 'dailywear-party-wear'
      assign banner_file = 'banner-dailywear.png'
    when 'necklaces-pendants'
      assign banner_file = 'banner-necklaces-pendants.png'
    when 'jewellery-sets'
      assign banner_file = 'banner-jewellery-sets.png'
  endcase
%}

{% if banner_file != '' %}
  <div class="collection-banner-media">
    <img
      src="{{ banner_file | asset_url }}"
      alt="{{ collection.title | escape }} banner"
      loading="lazy"
    >
  </div>
{% endif %}

{% stylesheet %}
  /* The custom-liquid block wraps output in a plain div which is the direct
     flex child of the section row (.section-content-wrapper). Hide that
     wrapper below desktop so no gap remains; heading goes full-width. */
  .section-content-wrapper > div:has(> .collection-banner-media) {
    display: none;
  }

  @media screen and (min-width: 990px) {
    /* Grow the wrapper to fill the row so the image reaches the right edge. */
    .section-content-wrapper > div:has(> .collection-banner-media) {
      display: flex;
      flex: 1 1 0;
      min-width: 0;
    }

    .collection-banner-media {
      display: block;
      width: 100%;
    }

    /* Compact editorial strip: fixed ~200px like the reference. */
    .collection-banner-media img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      display: block;
    }
  }
{% endstylesheet %}
