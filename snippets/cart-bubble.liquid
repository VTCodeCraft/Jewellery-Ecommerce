{%- doc -%}
  @param [limit] - {number}

  The maximum number of items to display. Anything above shows as "99+".

  @param [count] - {number} Overrides cart.item_count. Lets a non-cart counter
  (the wishlist badge) reuse this component instead of copying its markup.

  @param [interactive] - {boolean} Defaults to true. Pass false outside the cart
  icon: the refs and the cart-bubble-text id are then omitted, so a second bubble
  cannot steal cart-icon.js's refs or duplicate that id.

  @param [testid] - {string} Defaults to "cart-bubble".

  Colors: reads --cart-bubble-background / --cart-bubble-text from an ancestor. Falls back to a contrasting pair
  computed from the palette foreground when unset.
{%- enddoc -%}

{% liquid
  assign bubble_bg_fallback = settings.page_text_color
  assign bubble_text_fallback = settings.page_background_color

  assign item_count = count
  if count == blank
    assign item_count = cart.item_count
  endif

  assign is_interactive = true
  if interactive == false
    assign is_interactive = false
  endif

  assign bubble_testid = testid | default: 'cart-bubble'
%}

<div
  {% if is_interactive %}
    ref="cartBubble"
  {% endif %}
  class="cart-bubble{% if item_count == 0 %} visually-hidden{% endif %}"
  style="--cart-bubble-background-fallback: {{ bubble_bg_fallback }}; --cart-bubble-text-fallback: {{ bubble_text_fallback }};"
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    {% if is_interactive %}
      ref="cartBubbleText"
      id="cart-bubble-text"
    {% endif %}
    class="cart-bubble__text"
  >
    <span
      class="cart-bubble__text-count{% if item_count == 0 %} hidden{% endif %}"
      {% if is_interactive %}
        ref="cartBubbleCount"
      {% endif %}
      aria-hidden="true"
      data-testid="{{ bubble_testid }}"
    >
      {%- if limit == blank or item_count < limit %}
        {{- item_count -}}
      {%- endif -%}
    </span>
  </span>
</div>

{% stylesheet %}
  .cart-bubble {
    --cart-padding: 0.2em;

    position: relative;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    border-width: 0;
    display: flex;
    line-height: normal;
    align-items: center;
    justify-content: center;
    color: var(--cart-bubble-text, var(--cart-bubble-text-fallback));
    padding-inline: var(--cart-padding);
  }

  .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
  }

  .cart-bubble[data-maintain-ratio] .cart-bubble__background {
    border-radius: var(--style-border-radius-50);
  }

  .cart-bubble__background {
    position: absolute;
    inset: 0;
    background-color: var(--cart-bubble-background, var(--cart-bubble-background-fallback));
    border-radius: var(--style-border-radius-lg);
  }

  .cart-bubble__text {
    font-size: var(--font-size--3xs);
    z-index: var(--layer-flat);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}
