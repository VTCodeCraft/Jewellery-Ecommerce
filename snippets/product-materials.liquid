{% doc %}Materials & Finish - smaller muted{% enddoc %}
{% if product.metafields.custom.material != blank %}
<div style="font-size: 13px; color: #725947; font-weight: 400; text-transform: capitalize;">{{ product.metafields.custom.material | downcase | capitalize }}</div>
