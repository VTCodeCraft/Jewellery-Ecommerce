{% doc %}
  @prompt
    Add a subtle customer-care information strip beneath the contact information section. Display label: "Customer Care" and editable notice text: "We aim to respond to your enquiry within 2–3 working days." Match Newora Jewels' warm, elegant branding.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reply-notice-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 16px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--brand-border, #D8C6B3);
    border-left: none;
    background-color: transparent;
  }

  .ai-reply-notice-{{ ai_gen_id }} .customer-care-strip__label {
    font-family: var(--font-subheading--family, inherit);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-muted, #725947);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-reply-notice-{{ ai_gen_id }} .customer-care-strip__text {
    margin: 0;
    font-family: var(--font-body--family, inherit);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--brand-muted, #725947);
    letter-spacing: 0.01em;
  }

  @media screen and (max-width: 749px) {
    .ai-reply-notice-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 18px 0 0;
    }
  }
{% endstyle %}

<div class="ai-reply-notice-{{ ai_gen_id }} customer-care-strip" role="note" {{ block.shopify_attributes }}>
  <span class="customer-care-strip__label">Customer Care</span>
  <p class="customer-care-strip__text">{{ block.settings.notice_text | escape }}</p>
</div>

{% schema %}
{
  "name": "Customer care strip",
  "settings": [
    {
      "type": "text",
      "id": "notice_text",
      "label": "Notice text",
      "default": "We aim to respond to your enquiry within 2–3 working days."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Customer care strip"
    }
  ],
  "tag": null,
  "class": "customer-care-strip-wrapper"
}
{% endschema %}