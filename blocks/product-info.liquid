{%- doc -%}
  Product info block.

  Renders one piece of product information - the description, a product
  metafield, the store's shipping/refund policies or custom text - either as
  an accordion row or as plain text. It renders nothing on the storefront
  when the resolved content is empty, so a product with an unfilled
  metafield never shows an empty accordion. In the theme editor an empty
  block still shows a muted placeholder so it can be selected and edited.

  Metafield sources read the store's existing definitions (custom.material,
  custom.color_finish, custom.size_length, custom.ocassion_style,
  custom.care_instructions). Care instructions fall back to any
  "Jewellery care" paragraph embedded in the description, so older products
  still show their care notes in the accordion and nowhere else.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign content = ''

  case block_settings.source
    when 'description'
      capture content
        render 'product-description-parts', product: product, part: 'body'
      endcapture

    when 'care'
      assign care = product.metafields.custom.care_instructions
      if care != blank
        assign content = care | escape | newline_to_br
      else
        capture content
          render 'product-description-parts', product: product, part: 'care'
        endcapture
      endif

    when 'size'
      assign size = product.metafields.custom.size_length
      if size != blank
        assign content = size | escape
      endif

    when 'materials'
      assign material = product.metafields.custom.material
      assign finish = product.metafields.custom.color_finish
      if material != blank or finish != blank
        capture content
          echo '<dl class="product-info__list">'
          if material != blank
            echo '<dt>Material</dt><dd>' | append: material | append: '</dd>'
          endif
          if finish != blank
            echo '<dt>Finish</dt><dd>' | append: finish | append: '</dd>'
          endif
          echo '</dl>'
        endcapture
      endif

    when 'occasion'
      assign occasion = product.metafields.custom.ocassion_style
      if occasion != blank
        assign content = occasion | escape
      endif

    when 'policies'
      assign shipping = shop.shipping_policy.body
      assign refund = shop.refund_policy.body
      capture content
        if shipping != blank
          if refund != blank
            echo '<p class="product-info__subheading">' | append: shop.shipping_policy.title | append: '</p>'
          endif
          echo shipping
        endif
        if refund != blank
          if shipping != blank
            echo '<p class="product-info__subheading">' | append: shop.refund_policy.title | append: '</p>'
          endif
          echo refund
        endif
      endcapture

    when 'metafield'
      assign key_parts = block_settings.metafield_key | strip | split: '.'
      if key_parts.size == 2
        assign namespace = key_parts[0]
        assign key = key_parts[1]
        assign metafield = product.metafields[namespace][key]
        if metafield != blank
          assign content = metafield | metafield_tag
        endif
      endif

    when 'text'
      assign content = block_settings.text
  endcase

  assign visible_text = content | strip_html | strip
-%}

{%- if visible_text != blank -%}
  {%- if block_settings.layout == 'accordion' -%}
    {%- capture accordion_row -%}
      <details
        class="details"
        data-testid="accordion-details"
        {% if block_settings.open_by_default %}
          open
        {% endif %}
      >
        <summary class="details__header product-info__summary">
          {{ block_settings.heading | escape }}
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="details-content">
          <div class="product-info__content product-info__content--accordion rte">{{ content }}</div>
        </div>
      </details>
    {%- endcapture -%}
    <div
      class="product-info product-info--accordion {% if block_settings.icon == 'caret' %}product-info--icon-caret{% else %}product-info--icon-plus{% endif %}"
      {{ block.shopify_attributes }}
    >
      {% render 'accordion-custom-component',
        children: accordion_row,
        open_by_default_on_desktop: block_settings.open_by_default,
        open_by_default_on_mobile: block_settings.open_by_default
      %}
    </div>
    {% render 'accordion-styles' %}
  {%- else -%}
    <div class="product-info product-info--inline" {{ block.shopify_attributes }}>
      {% if block_settings.heading != blank %}
        <p class="product-info__label">{{ block_settings.heading | escape }}</p>
      {% endif %}
      <div class="product-info__content rte">{{ content }}</div>
    </div>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="product-info product-info--empty" {{ block.shopify_attributes }}>
    {{ block_settings.heading | escape }} &mdash; nothing to show for this product, so the block is hidden on the storefront.
  </div>
{%- endif -%}

{% stylesheet %}
  .product-info {
    width: 100%;
  }

  /* Accordion rows: heading in the small-label preset, hairline dividers
     between adjacent rows and a closing hairline after the last one. */
  .product-info--accordion {
    border-block-start: var(--style-border-width) solid var(--color-border);
  }

  .product-info--accordion:not(:has(+ .product-info--accordion)) {
    border-block-end: var(--style-border-width) solid var(--color-border);
  }

  .product-info__summary {
    font-family: var(--font-h6--family);
    font-style: var(--font-h6--style);
    font-weight: var(--font-h6--weight);
    font-size: var(--font-h6--size);
    line-height: var(--font-h6--line-height);
    letter-spacing: var(--font-h6--letter-spacing);
    text-transform: var(--font-h6--case);
    min-height: var(--minimum-touch-target);
    padding-block: var(--padding-lg);
  }

  .product-info--icon-plus .icon-caret,
  .product-info--icon-caret .icon-plus {
    display: none;
  }

  .product-info__content--accordion {
    padding-block-end: var(--padding-lg);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .product-info__content > :first-child {
    margin-block-start: 0;
  }

  .product-info__content > :last-child {
    margin-block-end: 0;
  }

  .product-info__label,
  .product-info__subheading {
    font-family: var(--font-h6--family);
    font-weight: var(--font-h6--weight);
    font-size: var(--font-h6--size);
    letter-spacing: var(--font-h6--letter-spacing);
    text-transform: var(--font-h6--case);
    margin-block: 0 var(--margin-xs);
  }

  .product-info__subheading:not(:first-child) {
    margin-block-start: var(--margin-lg);
  }

  .product-info__list {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--gap-2xs) var(--gap-lg);
    margin: 0;
  }

  .product-info__list dt {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text));
  }

  .product-info__list dd {
    margin: 0;
  }

  .product-info--empty {
    padding: var(--padding-sm);
    border: 1px dashed var(--color-border);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text));
    font-size: var(--font-size--xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product info",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Details"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Content",
      "options": [
        {
          "value": "description",
          "label": "Product description"
        },
        {
          "value": "size",
          "label": "Size & fit (custom.size_length)"
        },
        {
          "value": "materials",
          "label": "Materials & finish (material, color_finish)"
        },
        {
          "value": "occasion",
          "label": "Occasion & style (custom.ocassion_style)"
        },
        {
          "value": "care",
          "label": "Care instructions (custom.care_instructions)"
        },
        {
          "value": "policies",
          "label": "Shipping & returns (store policies)"
        },
        {
          "value": "metafield",
          "label": "Other product metafield"
        },
        {
          "value": "text",
          "label": "Custom text"
        }
      ],
      "default": "description",
      "info": "Hidden on the storefront when the chosen content is empty for a product. Care instructions fall back to any \"Jewellery care\" paragraph in the description."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield",
      "info": "namespace.key, for example custom.warranty",
      "visible_if": "{{ block.settings.source == 'metafield' }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "visible_if": "{{ block.settings.source == 'text' }}"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Display",
      "options": [
        {
          "value": "accordion",
          "label": "Accordion"
        },
        {
          "value": "inline",
          "label": "Plain text"
        }
      ],
      "default": "accordion"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false,
      "visible_if": "{{ block.settings.layout == 'accordion' }}"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "caret",
          "label": "Caret"
        }
      ],
      "default": "plus",
      "visible_if": "{{ block.settings.layout == 'accordion' }}"
    }
  ],
  "presets": [
    {
      "name": "Product info",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
