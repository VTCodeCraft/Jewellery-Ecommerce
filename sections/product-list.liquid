

{% liquid
  assign max_items = section.settings.max_products
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign view_more_url = ''
  if section.settings.collection != blank
    assign view_more_url = section.settings.collection.url
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="product-list-slider__header">
    <div class="product-list-slider__header-left">
      {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
    </div>
    {% if view_more_url != blank %}
      <a href="{{ view_more_url }}" class="product-list-slider__view-more button-unstyled">
        View all
      </a>
    {% endif %}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% for product in section.settings.collection.products limit: max_items %}
      <div
        class="resource-list__item"
      >
          {% content_for 'block',
            type: '_product-card',
            id: 'static-product-card',
            closest.product: product,
            product_view_context: 'collection'
          %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% if section.settings.layout_type == 'grid' %}
    <product-list-slider data-section-id="{{ section.id }}">
      <div class="product-list-slider__track" data-slider-track>
        {% render 'resource-list',
          list_items: list_items,
          list_items_array: list_items_array,
          settings: section.settings,
          slide_count: max_items,
          content_type: 'products',
          test_id: 'resource-list-grid'
        %}
      </div>
      <div class="product-list-slider__scrollbar" data-slider-scrollbar>
        <div class="product-list-slider__scrollbar-thumb" data-slider-scrollbar-thumb></div>
      </div>
    </product-list-slider>
  {% else %}
    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      slide_count: max_items,
      content_type: 'products',
      test_id: 'resource-list-grid'
    %}
  {% endif %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .product-list-slider__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .product-list-slider__header-left {
    flex: 1;
    min-width: 0;
  }

  .product-list-slider__view-more {
    flex-shrink: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--body-sm, 0.875rem);
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .product-list-slider__view-more:hover {
    opacity: 0.7;
  }

  product-list-slider {
    display: block;
    position: relative;
  }

  .product-list-slider__track {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    /* Keep horizontal gestures inside the row: without containment a pan
       that reaches the row's edge chains into the page (or a back/forward
       swipe), which reads as the cards drifting during scroll. */
    overscroll-behavior-x: contain;
  }

  .product-list-slider__track::-webkit-scrollbar {
    display: none;
  }

  .product-list-slider__track .resource-list--grid {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--resource-list-column-gap);
    width: max-content;
  }

  .product-list-slider__track .resource-list__item {
    flex: 0 0 auto;
    width: calc((100cqw - var(--resource-list-column-gap) * 3) / 4);
    container-type: inline-size;
  }

  .product-list-slider__track.is-dragging {
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
  }

  .product-list-slider__scrollbar {
    position: relative;
    width: 100%;
    height: 3px;
    margin-top: 16px;
    background: rgb(var(--color-foreground-rgb, 0, 0, 0) / 0.08);
    border-radius: 3px;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
  }

  product-list-slider[data-has-overflow="true"] .product-list-slider__scrollbar {
    opacity: 1;
    visibility: visible;
  }

  .product-list-slider__scrollbar-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    min-width: 32px;
    border-radius: 3px;
    background: rgb(var(--color-foreground-rgb, 0, 0, 0) / 0.35);
    cursor: grab;
    will-change: transform;
  }

  .product-list-slider__scrollbar-thumb:hover {
    background: rgb(var(--color-foreground-rgb, 0, 0, 0) / 0.55);
  }

  .product-list-slider__scrollbar-thumb.is-scrollbar-dragging {
    cursor: grabbing;
    background: rgb(var(--color-foreground-rgb, 0, 0, 0) / 0.55);
  }

  @media screen and (max-width: 749px) {
    .product-list-slider__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .product-list-slider__track .resource-list__item {
      width: calc((100cqw - var(--resource-list-column-gap)) / 2);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .product-list-slider__track .resource-list__item {
      width: calc((100cqw - var(--resource-list-column-gap) * 2) / 3);
    }
  }
{% endstylesheet %}

<script>
  (function () {
    const SLIDER_SELECTOR = 'product-list-slider';
    const TRACK_SELECTOR = '[data-slider-track]';
    const SCROLLBAR_SELECTOR = '[data-slider-scrollbar]';
    const THUMB_SELECTOR = '[data-slider-scrollbar-thumb]';
    const DRAG_THRESHOLD = 8;
    const INITIALIZED_ATTR = 'data-slider-init';

    function initSlider(el) {
      if (el.hasAttribute(INITIALIZED_ATTR)) return;

      const track = el.querySelector(TRACK_SELECTOR);
      if (!track) return;

      const scrollbar = el.querySelector(SCROLLBAR_SELECTOR);
      const thumb = el.querySelector(THUMB_SELECTOR);

      el.setAttribute(INITIALIZED_ATTR, '1');

      /* ---- overflow + scrollbar sync ---- */

      function updateOverflow() {
        const scrollWidth = track.scrollWidth;
        const clientWidth = track.clientWidth;
        const scrollLeft = track.scrollLeft;
        const tolerance = 2;
        const hasOverflow = scrollWidth - clientWidth > tolerance;

        el.setAttribute('data-has-overflow', String(hasOverflow));

        if (scrollLeft <= tolerance) {
          el.setAttribute('data-scroll-position', 'start');
        } else if (scrollLeft >= scrollWidth - clientWidth - tolerance) {
          el.setAttribute('data-scroll-position', 'end');
        } else {
          el.setAttribute('data-scroll-position', 'middle');
        }

        if (!scrollbar || !thumb) return;

        if (!hasOverflow) {
          thumb.style.width = '0px';
          thumb.style.transform = 'translateX(0)';
          return;
        }

        var maxScroll = scrollWidth - clientWidth;
        var ratio = maxScroll > 0 ? scrollLeft / maxScroll : 0;

        /* Thumb width: proportion of visible area, clamped to min 32px */
        var trackWidth = scrollbar.clientWidth || clientWidth;
        var thumbWidthPct = clientWidth / scrollWidth;
        var thumbWidth = Math.max(32, thumbWidthPct * trackWidth);
        var thumbMaxTravel = trackWidth - thumbWidth;

        if (thumbMaxTravel < 0) thumbMaxTravel = 0;

        var thumbLeft = ratio * thumbMaxTravel;

        thumb.style.width = thumbWidth + 'px';
        thumb.style.transform = 'translateX(' + thumbLeft + 'px)';
      }

      track.addEventListener('scroll', updateOverflow, { passive: true });
      new ResizeObserver(updateOverflow).observe(track);
      updateOverflow();

      el._sliderRecalc = updateOverflow;

      /* ---- product row drag ---- */

      var dragState = null;

      function onMouseMove(e) {
        var ds = dragState;
        if (!ds) return;

        var dx = e.clientX - ds.startX;
        var dy = e.clientY - ds.startY;

        if (!ds.dragging) {
          if (Math.abs(dx) <= DRAG_THRESHOLD && Math.abs(dy) <= DRAG_THRESHOLD) return;
          if (Math.abs(dy) > Math.abs(dx)) {
            cleanupDrag();
            return;
          }
          ds.dragging = true;
          track.classList.add('is-dragging');
          document.body.style.userSelect = 'none';
          document.body.style.webkitUserSelect = 'none';
        }

        e.preventDefault();
        track.scrollLeft = ds.startScrollLeft - dx;
      }

      function onMouseUp() {
        cleanupDrag();
      }

      function cleanupDrag() {
        if (dragState && dragState.dragging) {
          track.classList.remove('is-dragging');
          document.body.style.userSelect = '';
          document.body.style.webkitUserSelect = '';
        }
        dragState = null;
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
      }

      el.addEventListener('mousedown', function (e) {
        if (e.button !== 0) return;
        if (e.target.closest('a, button, input, textarea, select')) return;

        e.preventDefault();

        dragState = {
          startX: e.clientX,
          startY: e.clientY,
          startScrollLeft: track.scrollLeft,
          dragging: false,
        };

        document.addEventListener('mousemove', onMouseMove, { passive: false });
        document.addEventListener('mouseup', onMouseUp);
      });

      /* ---- scrollbar thumb drag ---- */

      if (scrollbar && thumb) {
        var thumbDrag = null;

        function onThumbMove(e) {
          if (!thumbDrag) return;
          e.preventDefault();

          var trackWidth = scrollbar.clientWidth || track.clientWidth;
          var scrollWidth = track.scrollWidth;
          var clientWidth = track.clientWidth;
          var thumbWidth = thumb.clientWidth;
          var maxScroll = scrollWidth - clientWidth;
          var maxThumbLeft = trackWidth - thumbWidth;

          if (maxThumbLeft <= 0 || maxScroll <= 0) return;

          var dx = e.clientX - thumbDrag.startX;
          var newThumbLeft = Math.max(0, Math.min(maxThumbLeft, thumbDrag.startThumbLeft + dx));
          var ratio = newThumbLeft / maxThumbLeft;

          track.scrollLeft = thumbDrag.startScrollLeft + ratio * maxScroll;
        }

        function onThumbUp() {
          if (thumbDrag) {
            track.classList.remove('is-dragging');
            thumb.classList.remove('is-scrollbar-dragging');
            thumbDrag = null;
          }
          document.removeEventListener('mousemove', onThumbMove);
          document.removeEventListener('mouseup', onThumbUp);
        }

        thumb.addEventListener('mousedown', function (e) {
          e.preventDefault();
          e.stopPropagation();

          var thumbRect = thumb.getBoundingClientRect();
          var scrollbarRect = scrollbar.getBoundingClientRect();

          thumbDrag = {
            startX: e.clientX,
            startScrollLeft: track.scrollLeft,
            startThumbLeft: thumbRect.left - scrollbarRect.left,
          };

          /* Reuse the track's is-dragging state so `scroll-behavior: auto`
             applies while the thumb is held. Without it every scrollLeft
             assignment below starts a smooth-scroll glide, and the cards
             visibly lag behind the thumb before settling. */
          track.classList.add('is-dragging');
          thumb.classList.add('is-scrollbar-dragging');
          document.addEventListener('mousemove', onThumbMove, { passive: false });
          document.addEventListener('mouseup', onThumbUp);
        });

        scrollbar.addEventListener('click', function (e) {
          if (e.target === thumb || thumbDrag) return;

          var scrollbarRect = scrollbar.getBoundingClientRect();
          var clickX = e.clientX - scrollbarRect.left;
          var trackWidth = scrollbar.clientWidth || track.clientWidth;
          var thumbWidth = thumb.clientWidth;
          var maxScroll = track.scrollWidth - track.clientWidth;
          var maxThumbLeft = trackWidth - thumbWidth;

          if (maxThumbLeft <= 0 || maxScroll <= 0) return;

          var targetThumbLeft = clickX - thumbWidth / 2;
          var ratio = Math.max(0, Math.min(1, targetThumbLeft / maxThumbLeft));

          track.scrollTo({ left: ratio * maxScroll, behavior: 'smooth' });
        });
      }
    }

    /* ---- initialize all existing sliders ---- */
    function initAll() {
      document.querySelectorAll(SLIDER_SELECTOR).forEach(initSlider);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    /* ---- recalculate after full page load (images, fonts, etc.) ---- */
    window.addEventListener('load', function () {
      requestAnimationFrame(function () {
        document.querySelectorAll(SLIDER_SELECTOR).forEach(function (el) {
          if (typeof el._sliderRecalc === 'function') el._sliderRecalc();
        });
      });
    });

    /* ---- catch sliders added later (e.g. section rendering) ---- */
    new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        for (var j = 0; j < mutations[i].addedNodes.length; j++) {
          var node = mutations[i].addedNodes[j];
          if (node.nodeType !== 1) continue;
          if (node.matches && node.matches(SLIDER_SELECTOR)) initSlider(node);
          if (node.querySelectorAll) {
            node.querySelectorAll(SLIDER_SELECTOR).forEach(initSlider);
          }
        }
      }
    }).observe(document.body, { childList: true, subtree: true });
  })();
</script>

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.products_grid",
      "category": "t:categories.products",
      "settings": {
        "collection": "",
        "max_products": 8,
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 8,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
                "text": "<h3>{{ closest.collection.title }}</h3>",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_list_button": {
              "type": "_product-list-button",
              "name": "t:names.product_list_button",
              "settings": {
                "label": "t:text_defaults.view_all_button_label",
                "open_in_new_tab": false,
                "style_class": "button-unstyled",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              }
            }
          },
          "block_order": ["product_list_text", "product_list_button"]
        },
